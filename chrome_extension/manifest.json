{
  "manifest_version": 3,
  "name": "IPL Live Predictor",
  "version": "1.0.0",
  "description": "Live IPL match scores, predictions, and stats powered by your local dashboard.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8501/*",
    "https://api.cricapi.com/*",
    "https://www.espncricinfo.com/*",
    "https://www.cricbuzz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "IPL Live Predictor"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
